++    root = path.resolve(args[index + 1] ?? "");
++    index += 1;
++  } else if (args[index] === "--output") {
++    outputArg = args[index + 1] ?? "";
++    index += 1;
++  } else {
++    targets.push(args[index]);
++  }
++}
++
++if (!outputArg || targets.length === 0) {
++  usage();
++  process.exit(2);
++}
++
++const output = path.resolve(root, outputArg);
++const entries = [];
++for (const target of targets) {
