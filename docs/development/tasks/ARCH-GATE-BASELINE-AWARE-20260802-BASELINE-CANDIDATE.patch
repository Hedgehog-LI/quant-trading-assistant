++  }
++  const baselineMetric = errorMetricForKind(baselineMatch);
++  if (candidateMetric !== null && baselineMetric !== null) {
++    const delta = candidateMetric - baselineMetric;
++    if (delta > ALLOWED_WORSEN_DELTA) {
