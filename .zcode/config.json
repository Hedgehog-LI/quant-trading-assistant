{
  "hooks": {
    "enabled": true,
    "timeoutMs": 5000,
    "maxOutputBytes": 4096,
    "events": {
      "UserPromptSubmit": [
        {
          "matcher": "(^|\\s)/qta-run(\\s|$)",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": [
                "${ZCODE_PROJECT_DIR}/scripts/zcode-governance-hook.mjs"
              ],
              "timeoutMs": 5000,
              "statusMessage": "Activating QTA governed run"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Bash|Read|Write|Edit|ApplyPatch|Agent|Task|AskUserQuestion",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": [
                "${ZCODE_PROJECT_DIR}/scripts/zcode-governance-hook.mjs"
              ],
              "timeoutMs": 5000,
              "statusMessage": "Checking QTA governance policy"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": [
                "${ZCODE_PROJECT_DIR}/scripts/zcode-governance-hook.mjs"
              ],
              "timeoutMs": 30000,
              "statusMessage": "Checking QTA Goal completion gate"
            }
          ]
        }
      ]
    }
  }
}
