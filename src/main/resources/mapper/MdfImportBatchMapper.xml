<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quant.trade.marketdata.foundation.dao.MdfImportBatchMapper">

    <resultMap id="BaseResultMap" type="com.quant.trade.marketdata.foundation.model.MdfImportBatchDO">
        <id column="id" property="id"/>
        <result column="import_kind" property="importKind"/>
        <result column="provider_code" property="providerCode"/>
        <result column="file_name" property="fileName"/>
        <result column="file_hash" property="fileHash"/>
        <result column="inserted_count" property="insertedCount"/>
        <result column="updated_count" property="updatedCount"/>
        <result column="skipped_count" property="skippedCount"/>
        <result column="rejected_count" property="rejectedCount"/>
        <result column="status" property="status"/>
        <result column="error_report_json" property="errorReportJson"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO mdf_import_batch (import_kind, provider_code, file_name, file_hash, inserted_count,
            updated_count, skipped_count, rejected_count, status, error_report_json)
        VALUES (#{importKind}, #{providerCode}, #{fileName}, #{fileHash}, #{insertedCount},
            #{updatedCount}, #{skippedCount}, #{rejectedCount}, #{status}, #{errorReportJson})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM mdf_import_batch WHERE id = #{id}
    </select>

    <select id="selectByKindAndHash" resultMap="BaseResultMap">
        SELECT * FROM mdf_import_batch WHERE import_kind = #{importKind} AND file_hash = #{fileHash}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM mdf_import_batch
        <where>
            <if test="importKind != null and importKind != ''">AND import_kind = #{importKind}</if>
        </where>
        ORDER BY id DESC LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
